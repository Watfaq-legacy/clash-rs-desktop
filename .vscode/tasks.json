{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo: check workspace",
            "type": "shell",
            "command": "cargo check --workspace --all-targets",
            "group": "build",
            "problemMatcher": "$rustc"
        },
        {
            "label": "cargo: test workspace",
            "type": "shell",
            "command": "cargo test --workspace",
            "group": "test",
            "problemMatcher": "$rustc"
        },
        {
            "label": "clash-rs desktop: run reactor UI dev root",
            "type": "shell",
            "command": "cargo run -p clash-rs-desktop-ui --features reactor -- --dev",
            "group": "test",
            "problemMatcher": "$rustc"
        },
        {
            "label": "clash-rs desktop: build reactor UI",
            "type": "shell",
            "command": "cargo build -p clash-rs-desktop-ui --features reactor",
            "group": "build",
            "problemMatcher": "$rustc"
        },
        {
            "label": "clash-rs desktop: package portable",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File .\\scripts\\package-portable.ps1",
            "group": "build",
            "problemMatcher": "$rustc"
        },
        {
            "label": "clash-rs desktop: check reactor UI",
            "type": "shell",
            "command": "cargo check -p clash-rs-desktop-ui --features reactor",
            "group": "build",
            "problemMatcher": "$rustc"
        }
    ]
}