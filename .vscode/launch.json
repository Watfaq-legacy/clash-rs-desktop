{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Reactor UI (--dev)",
            "type": "node-terminal",
            "request": "launch",
            "command": "cargo run -p clash-rs-desktop-ui --features reactor -- --dev",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Portable Reactor UI",
            "type": "node-terminal",
            "request": "launch",
            "command": ".\\bin\\clash-rs-desktop-ui.exe",
            "cwd": "${workspaceFolder}\\dist\\clash-rs-desktop-windows-x64",
            "preLaunchTask": "clash-rs desktop: package portable"
        }
    ]
}